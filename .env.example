# Copy this file to .env and fill in the values.
# Never commit .env to source control.

# Azure Blob Storage – get this from the Azure Portal → Storage account → Access keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net

# Optional – defaults to "clasicfieldphoto"
AZURE_BLOB_CONTAINER=clasicfieldphoto

# App login is for local development fallback until App Service authentication is enabled.
APP_LOGIN_USERNAME=admin
APP_LOGIN_PASSWORD=change-this-password
ALLOW_LOCAL_LOGIN=1

# App Service Authentication (Microsoft Entra) - set to 1 in Azure when enabled.
USE_EASY_AUTH=0

# Restrict sign-in to Skanska tenant(s).
ALLOWED_ENTRA_TENANT_IDS=33dab507-5210-4075-805b-f2717d8cfa74

# Snowflake – override only if different from the defaults in the script
# SNOWFLAKE_ACCOUNT=PGODCHG-UR78062
# SNOWFLAKE_USER=NOSYS_ISSUES_KEYPAIR
# SNOWFLAKE_ROLE=NOSYS_ISSUES
# SNOWFLAKE_WAREHOUSE=INTEGRATION_WH

# Snowflake keypair authentication (JKS)
# SNOWFLAKE_JKS_PATH=snowflake1(1).jks
# SNOWFLAKE_JKS_ALIAS=snowflake
# SNOWFLAKE_JKS_PASSWORD=change-me
# SNOWFLAKE_JKS_KEY_PASSWORD=change-me
# SNOWFLAKE_AZURE_SAS_TOKEN=?sv=...
